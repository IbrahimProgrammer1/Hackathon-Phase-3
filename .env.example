# Backend: Database (Neon connection string goes here)
DATABASE_URL=postgresql://username:password@localhost:5432/todo_db

# Backend: Authentication (JWT signing secret)
BETTER_AUTH_SECRET=your-super-secret-jwt-key-here-make-it-long-and-random

# Backend: CORS (comma-separated)
CORS_ALLOW_ORIGINS=http://localhost:3000

# Frontend (Next.js): Backend origin (NO /api)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000